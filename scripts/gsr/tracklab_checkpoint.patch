+    def _checkpoint(self, i, model_name, detections, image_pred):
+        """Persist an intermediate pipeline state so a crashed run can resume after this module.
+
+        Gated by TRACKLAB_CHECKPOINT_DIR -- unset by default, so this is a no-op and behaviour is
+        unchanged. When set, writes the exact byte layout TrackerState.save()/.load() already use
+        (tracklab/datastruct/tracker_state.py): an UNCOMPRESSED zip (allowZip64, force_zip64 on
+        every member) containing `summary.json` ({"columns": {"detection": [...], "image": [...]}}),
+        `<video_id>.pkl` (pickled detections) and `<video_id>_image.pkl` (pickled image_pred). A
+        checkpoint is therefore byte-compatible with `state.load_file` as-is -- no special loader
+        needed to resume from one.
+
+        Named `<video_id>-<i:02d>-<model_name>.pklz` so a resume script can find the newest file,
+        recover which module it was taken after from the name, and compute the remaining pipeline
+        tail. Written to a `.part` path and atomically renamed on completion, so a crash mid-write
+        can never hand a resume attempt a truncated zip.
+
+        IMPORTANT: this only records columns modules *up to this point* produced. A module further
+        down the pipeline (e.g. `team`) can declare an earlier module's output (e.g. reid's
+        `embeddings`) as an input, which is why `_drop_forgotten_columns` keeps it around -- so a
+        checkpoint taken during a run with the full pipeline attached carries those columns too.
+        Resuming must always pass the entire remaining module tail, not a truncated one, or a
+        downstream module can find its declared input columns silently missing.
+        """
+        ckpt_dir = os.environ.get("TRACKLAB_CHECKPOINT_DIR")
+        if not ckpt_dir or detections.empty:
+            return
+        video_id = self.tracker_state.video_id
+        os.makedirs(ckpt_dir, exist_ok=True)
+        final_path = os.path.join(ckpt_dir, f"{video_id}-{i:02d}-{model_name}.pklz")
+        part_path = final_path + ".part"
+        start = time.time()
+        with zipfile.ZipFile(part_path, mode="w", compression=zipfile.ZIP_STORED, allowZip64=True) as zf:
+            summary = {"columns": {
+                "detection": list(detections.columns),
+                "image": list(image_pred.columns),
+            }}
+            with zf.open("summary.json", "w", force_zip64=True) as fp:
+                fp.write(json.dumps(summary, ensure_ascii=False, indent=4).encode("utf-8"))
+            with zf.open(f"{video_id}.pkl", "w", force_zip64=True) as fp:
+                pickle.dump(detections, fp, protocol=pickle.DEFAULT_PROTOCOL)
+            with zf.open(f"{video_id}_image.pkl", "w", force_zip64=True) as fp:
+                pickle.dump(image_pred, fp, protocol=pickle.DEFAULT_PROTOCOL)
+        os.replace(part_path, final_path)
+        elapsed = time.time() - start
+        size_gb = os.path.getsize(final_path) / 1e9
+        log.info("checkpoint %s: %.1fs, %.2f GB", os.path.basename(final_path), elapsed, size_gb)
+
